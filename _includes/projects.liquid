<div class="col{% if project.status contains 'Ongoing' %} featured{% endif %}">
  <article class="card research-card h-100">
    {% assign project_link = project.redirect | default: project.url %}
    {% if project.img %}
      <a class="research-image" href="{{ project_link | relative_url }}" aria-label="Read about {{ project.title | escape }}">
        <img src="{{ project.img | relative_url }}" alt="{{ project.image_alt | default: project.title | escape }}" loading="lazy" width="800" height="340">
      </a>
    {% endif %}
    <div class="card-body">
      {% if project.status %}<p class="research-status">{{ project.status }}</p>{% endif %}
      <h2 class="card-title"><a href="{{ project_link | relative_url }}">{{ project.title }}</a></h2>
      <p class="card-text">{{ project.description }}</p>
      {% if project.contribution %}<p class="research-role">{{ project.contribution }}</p>{% endif %}
      <div class="research-links">
        {% if project.paper %}<a href="{{ project.paper }}">Paper</a>{% endif %}
        {% if project.code %}<a href="{{ project.code }}">Code</a>{% endif %}
        <a href="{{ project_link | relative_url }}">{% if project.redirect contains 'github.com' %}View code{% else %}Project page{% endif %}</a>
      </div>
    </div>
  </article>
</div>
